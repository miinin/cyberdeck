// SEC-098 liite: ehdotus firestore.rules-muutokseksi (T-098, D-025). EI DEPLOYATTU.
// Digiturva 2026-10-06. Koodari siirtää tämän firestore.rules-tiedostoon Arkkitehdin vahvistettua
// tietomallin; käyttäjä deployaa (ensin --project test, SEC-098-7:n käsitestit, sitten --project default).
//
// Muutokset nykyiseen firestore.rulesiin:
//   1) Uudet funktiot publicKey, isPublicDeck (alla).
//   2) isDeckDoc sallii valinnaiset kentät visibility ja nickname (SR-35). Vanhat dokumentit kelpaavat yhä.
//   3) Uusi juuritason match /publicDecks/{pubId} (SR-30, SR-31, SR-33, SR-34, SR-40).
// Muut säännöt (users/{uid}, collection, isMeta jne.) pysyvät ennallaan.

// ---------- 1) Uudet funktiot (service cloud.firestore -lohkon sisälle muiden funktioiden viereen) ----------

    // The public document id is bound to the signed-in user without publishing the uid (SR-30):
    // pubId = lowercase hex of sha256(uid + ":" + deckId). Nobody else can compute the same id.
    // SEC-098-7: verify hashing.sha256(...).toHexString() in the test project before production.
    function publicKey(deckId) {
      return hashing.sha256(request.auth.uid + ':' + deckId).toHexString().lower();
    }

    function isPublicDeck(d) {
      return hasExactly(d, ['schemaVersion', 'deckId', 'name', 'legends', 'cardCount', 'deck',
                            'nickname', 'publishedAt', 'updatedAt'])
        && isVersion(d.schemaVersion)
        && d.deckId is string && d.deckId.matches('^[A-Za-z0-9_-]{1,64}$')
        && isText(d.name, 1, 200)
        && isText(d.legends, 0, 300)
        && d.cardCount is int && d.cardCount >= 0 && d.cardCount <= 49500
        && isText(d.deck, 1, 16000) && d.deck.matches('^[A-Za-z0-9_-]+$')
        && (d.nickname == null || isText(d.nickname, 1, 60))
        && d.publishedAt is timestamp
        && d.updatedAt == request.time;
    }

// ---------- 2) isDeckDoc korvataan tällä (SR-35) ----------

    // visibility and nickname are optional, so decks saved before T-098 stay valid.
    function isDeckDoc(d) {
      return isEnvelope(d)
        && d.data.keys().hasAll(['name', 'sections', 'createdAt', 'updatedAt'])
        && d.data.keys().hasOnly(['name', 'sections', 'createdAt', 'updatedAt', 'visibility', 'nickname'])
        && isText(d.data.name, 1, 200)
        && d.data.sections is list
        && d.data.sections.size() <= 20
        && isText(d.data.createdAt, 1, 40)
        && isText(d.data.updatedAt, 1, 40)
        && (!('visibility' in d.data) || d.data.visibility in ['private', 'public', 'public-anonymous'])
        && (!('nickname' in d.data) || d.data.nickname == null || isText(d.data.nickname, 1, 60));
    }
    // Arkkitehti päättää lopullisen muodon (esim. visibility + erillinen showNickname-boolean);
    // vaatimus on vain, että kentät ovat rajattuja ja valinnaisia.

// ---------- 3) Uusi match-lohko (juuritasolla, users/{uid}-lohkon sisaruksena) ----------

    // Public decks (T-098, D-025). Anyone can read, also signed-out visitors. Queries must set a limit (SR-33).
    // Only the owner can write; the owner is proven by the document id, not by a stored uid (SR-30).
    match /publicDecks/{pubId} {
      allow get: if true;
      allow list: if request.query.limit <= 50;

      allow create: if isGoogleUser()
        && isPublicDeck(request.resource.data)
        && pubId == publicKey(request.resource.data.deckId)
        && request.resource.data.publishedAt == request.time;

      // deckId and publishedAt never change; at most one update per 10 s per deck (SR-34).
      allow update: if isGoogleUser()
        && pubId == publicKey(resource.data.deckId)
        && isPublicDeck(request.resource.data)
        && request.resource.data.deckId == resource.data.deckId
        && request.resource.data.publishedAt == resource.data.publishedAt
        && request.time > resource.data.updatedAt + duration.value(10, 's');

      // Deleting a missing document is allowed by Firestore without evaluating resource, so account
      // deletion can delete every possible pubId without reading first (SR-36).
      allow delete: if isGoogleUser()
        && (resource == null || pubId == publicKey(resource.data.deckId));
    }

// Huomio delete-säännöstä: kun dokumenttia ei ole, resource == null ja poisto on no-op. Kukaan ei voi
// poistaa toisen olemassa olevaa dokumenttia, koska silloin resource != null ja tiiviste ei täsmää.
// Indeksi: orderBy('updatedAt', 'desc') ilman where-ehtoja käyttää automaattista yhden kentän indeksiä,
// joten firestore.indexes.json ei muutu.

rules_version = '2';

// Cyberdeck Firestore rules (T-054b). Source: SEC-011 liite A
// (docs/reports/SEC-011-t054-liite-firestore.rules) with D-017 Muutos K-P8: the root is always
// 'users' and the same file is deployed to both projects (cyberdeck-tcg and cyberdeck-tcg-dev).
// Changes need a Digiturva review (SR-9, SR-22 kohta 5). The user deploys by hand:
//   firebase deploy --only firestore:rules,firestore:indexes --project test     (before merging to test)
//   firebase deploy --only firestore:rules,firestore:indexes --project default  (before /julkaise)
//
// Data model (D-017 kohta 3):
//   users/{uid}                  meta { schemaVersion, rev, updatedAt }
//   users/{uid}/decks/{deckId}   { schemaVersion, savedAt, data: { name, sections, createdAt, updatedAt,
//                                  visibility?, nickname? } }
//   users/{uid}/collection/main  { schemaVersion, savedAt, data: { entries } }
//   users/{uid}/collection/want  same shape: the want list (T-064a, D-018)
//   users/{uid}/games/log        { schemaVersion, savedAt, data: { games } }: the game results (T-122, D-030)
//   publicDecks/{pubId}          public copy of a deck, pubId = sha256(uid:deckId) (T-098, D-025)
//   tradeShares/{shareId}        short trade link, shareId = first 16 hex of sha256(uid#trade) (T-178, D-037)
//
// The rules are a ceiling against abuse, not a full validation of the data model: list items cannot be
// checked here, so the client validates everything it reads (SR-23). String limits have some slack
// (name 200), because size() in the rules and the client's character count may differ.

service cloud.firestore {
  match /databases/{database}/documents {

    // Only Google sign-in counts, even if anonymous or email sign-in were enabled by mistake (SR-21, SR-25).
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOwner(uid) {
      return isGoogleUser() && request.auth.uid == uid;
    }

    function hasExactly(m, ks) {
      return m.keys().hasAll(ks) && m.keys().hasOnly(ks);
    }

    // Newer schema versions are allowed, so a new app version does not need a rules deploy.
    // An older client locks itself on a newer version (SR-23).
    function isVersion(v) {
      return v is int && v >= 1 && v <= 1000;
    }

    function isText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isEnvelope(d) {
      return hasExactly(d, ['schemaVersion', 'savedAt', 'data'])
        && isVersion(d.schemaVersion)
        && isText(d.savedAt, 1, 40)
        && d.data is map;
    }

    // updatedAt is the server time (serverTimestamp()), not the client's clock.
    function isMeta(d) {
      return hasExactly(d, ['schemaVersion', 'rev', 'updatedAt'])
        && isVersion(d.schemaVersion)
        && d.rev is int
        && d.updatedAt == request.time;
    }

    // The publishing settings are optional, so decks saved before T-098 stay valid (T-098, SR-35).
    // The nickname is cleaned to 1-30 characters by the client; 60 here is slack for size() differences.
    function isDeckDoc(d) {
      return isEnvelope(d)
        && d.data.keys().hasAll(['name', 'sections', 'createdAt', 'updatedAt'])
        && d.data.keys().hasOnly(['name', 'sections', 'createdAt', 'updatedAt', 'visibility', 'nickname'])
        && isText(d.data.name, 1, 200)
        && d.data.sections is list
        && d.data.sections.size() <= 20
        && isText(d.data.createdAt, 1, 40)
        && isText(d.data.updatedAt, 1, 40)
        && (!('visibility' in d.data) || d.data.visibility in ['private', 'public'])
        && (!('nickname' in d.data) || d.data.nickname == null || isText(d.data.nickname, 1, 60));
    }

    // The public document id is bound to the signed-in user without publishing the uid (SR-30):
    // pubId = lowercase hex of sha256(uid + ':' + deckId). Nobody else can compute the same id.
    // SEC-098-7: verify hashing.sha256(...).toHexString() in the test project before production.
    function publicKey(deckId) {
      return hashing.sha256(request.auth.uid + ':' + deckId).toHexString().lower();
    }

    // The public copy (SR-31): exact keys, bounded strings and numbers, no lists, server time.
    function isPublicDeck(d) {
      return hasExactly(d, ['schemaVersion', 'deckId', 'name', 'legends', 'cardCount', 'deck',
                            'nickname', 'publishedAt', 'updatedAt'])
        && isVersion(d.schemaVersion)
        && d.deckId is string && d.deckId.matches('^[A-Za-z0-9_-]{1,64}$')
        && isText(d.name, 1, 200)
        && isText(d.legends, 0, 300)
        && d.cardCount is int && d.cardCount >= 0 && d.cardCount <= 49500
        && isText(d.deck, 1, 16000) && d.deck.matches('^[A-Za-z0-9_-]+$')
        && (d.nickname == null || isText(d.nickname, 1, 60))
        && d.publishedAt is timestamp
        && d.updatedAt == request.time;
    }

    function isCollectionDoc(d) {
      return isEnvelope(d)
        && hasExactly(d.data, ['entries'])
        && d.data.entries is list
        && d.data.entries.size() <= 5000;
    }

    function isGamesDoc(d) {
      return isEnvelope(d)
        && hasExactly(d.data, ['games'])
        && d.data.games is list
        && d.data.games.size() <= 1000;
    }

    // The trade link id is bound to the signed-in user the same way (SR-50, SR-51): the first 16 hex characters of
    // sha256(uid + '#trade'). '#' is not in a deckId, so the id never collides with a public deck id.
    // The shape check comes first: without it an id like '.*' would be built into the regex below and match anyone's hash.
    function tradeKey() {
      return hashing.sha256(request.auth.uid + '#trade').toHexString().lower();
    }

    function ownsTradeShare(shareId) {
      return shareId.matches('^[0-9a-f]{16}$')
        && tradeKey().matches('^' + shareId + '[0-9a-f]{48}$');
    }

    // The trade link (SR-52): exact keys, the share text only, server time. No uid, no nickname.
    function isTradeShare(d) {
      return hasExactly(d, ['schemaVersion', 'data', 'updatedAt'])
        && isVersion(d.schemaVersion)
        && isText(d.data, 1, 16000) && d.data.matches('^[A-Za-z0-9_-]+$')
        && d.updatedAt == request.time;
    }

    // The user document is the meta. Listing all users is allowed to nobody: there is no list rule.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && isMeta(request.resource.data)
        && request.resource.data.rev == 1;
      // rev grows by exactly one on every push (D-017 kohta 5).
      allow update: if isOwner(uid)
        && isMeta(request.resource.data)
        && request.resource.data.rev == resource.data.rev + 1;
      allow delete: if isOwner(uid);

      match /decks/{deckId} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && deckId.matches('^[A-Za-z0-9_-]{1,64}$')
          && isDeckDoc(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /collection/{docId} {
        allow get: if isOwner(uid) && docId in ['main', 'want', 'have'];
        allow create, update: if isOwner(uid)
          && docId in ['main', 'want', 'have']
          && isCollectionDoc(request.resource.data);
        allow delete: if isOwner(uid) && docId in ['main', 'want', 'have'];
      }

      match /games/{docId} {
        allow get: if isOwner(uid) && docId == 'log';
        allow create, update: if isOwner(uid)
          && docId == 'log'
          && isGamesDoc(request.resource.data);
        allow delete: if isOwner(uid) && docId == 'log';
      }
    }

    // Public decks (T-098, D-025, SEC-098). Anyone can read, also signed-out visitors. Queries must set a limit
    // (SR-33). Only the owner can write; the owner is proven by the document id, not by a stored uid (SR-30).
    match /publicDecks/{pubId} {
      allow get: if true;
      allow list: if request.query.limit <= 50;

      allow create: if isGoogleUser()
        && isPublicDeck(request.resource.data)
        && pubId == publicKey(request.resource.data.deckId)
        && request.resource.data.publishedAt == request.time;

      // deckId and publishedAt never change; at most one update per 10 s per deck (SR-34).
      allow update: if isGoogleUser()
        && pubId == publicKey(resource.data.deckId)
        && isPublicDeck(request.resource.data)
        && request.resource.data.deckId == resource.data.deckId
        && request.resource.data.publishedAt == resource.data.publishedAt
        && request.time > resource.data.updatedAt + duration.value(10, 's');

      // Deleting a missing document is allowed by Firestore without evaluating resource, so account deletion
      // can delete every possible pubId without reading first (SR-36).
      allow delete: if isGoogleUser()
        && (resource == null || pubId == publicKey(resource.data.deckId));
    }

    // Short trade links (T-178, D-037). Anyone who knows the id can read; there is no list rule, so the ids cannot be
    // enumerated (SR-52). The owner is proven by the id, which is computed from request.auth.uid, not from the document.
    match /tradeShares/{shareId} {
      allow get: if true;

      allow create: if isGoogleUser()
        && ownsTradeShare(shareId)
        && isTradeShare(request.resource.data);

      // At most one update per 10 s (SR-52).
      allow update: if isGoogleUser()
        && ownsTradeShare(shareId)
        && isTradeShare(request.resource.data)
        && request.time > resource.data.updatedAt + duration.value(10, 's');

      // The id is computed from the uid alone, so deleting a missing document works too (account deletion, SR-51, SR-56).
      allow delete: if isGoogleUser()
        && ownsTradeShare(shareId);
    }

    // Everything else is denied (Firestore's default when no rule allows).
  }
}
